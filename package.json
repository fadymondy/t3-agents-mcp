{
  "name": "t3-agents-mcp",
  "version": "0.3.0",
  "description": "Local stdio MCP server for Claude Code and Codex to manage T3 Code threads with orchestration protocol V2 support.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "t3-agents-mcp": "./dist/cli.js",
    "t3-code-agent-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "examples/orchestrator-prompt.md",
    "examples/orchestrator-prompt-standard.md",
    "README.md",
    "NOTICE",
    "docs/COMPATIBILITY.md",
    "scripts/pair.ps1",
    "scripts/pair.sh"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ws": "^8.21.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fadymondy/t3-agents-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "t3-code",
    "coding-agents",
    "claude-code",
    "codex",
    "cursor"
  ],
  "homepage": "https://github.com/fadymondy/t3-agents-mcp#readme",
  "bugs": {
    "url": "https://github.com/fadymondy/t3-agents-mcp/issues"
  }
}
